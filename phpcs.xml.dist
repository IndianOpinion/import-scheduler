<?xml version="1.0"?>
<ruleset name="import-scheduler">
    <description>PSR-12 for the plugin and its tests.</description>
    <file>src</file>
    <file>tests</file>
    <file>examples</file>
    <file>import-scheduler.php</file>
    <file>uninstall.php</file>
    <exclude-pattern>tests/stubs/*</exclude-pattern>
    <exclude-pattern>tests/phpstan/*</exclude-pattern>
    <arg name="extensions" value="php"/>
    <arg name="colors"/>
    <arg value="sp"/>
    <rule ref="PSR12">
        <exclude name="Generic.Files.LineLength"/>
    </rule>
    <!-- WP-CLI maps method names to subcommands, so "list_" is required. -->
    <rule ref="PSR1.Methods.CamelCapsMethodName">
        <exclude-pattern>src/Cli/Command.php</exclude-pattern>
    </rule>
    <!-- The plugin entry files and the public functions file have side effects by design. -->
    <rule ref="PSR1.Files.SideEffects">
        <exclude-pattern>import-scheduler.php</exclude-pattern>
        <exclude-pattern>uninstall.php</exclude-pattern>
        <exclude-pattern>src/autoload.php</exclude-pattern>
        <exclude-pattern>src/functions.php</exclude-pattern>
        <exclude-pattern>examples/*</exclude-pattern>
        <exclude-pattern>tests/bootstrap.php</exclude-pattern>
        <exclude-pattern>tests/phpstan-bootstrap.php</exclude-pattern>
        <exclude-pattern>tests/Integration/race-worker.php</exclude-pattern>
    </rule>
</ruleset>
